# LinkedIn OAuth 2.0 Credentials (From developer.linkedin.com)
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here

# Redirect URI configured in your LinkedIn Developer App
# Default for Streamlit local app:
LINKEDIN_REDIRECT_URI=http://localhost:8501

# Requested LinkedIn Scopes (space-separated)
# Minimum scopes required for profile and posting:
LINKEDIN_SCOPES=openid profile w_member_social

# Ollama Local Configuration (Zero Cloud Costs)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_WRITING_MODEL=qwen2.5:3b
OLLAMA_VISION_MODEL=moondream

# Performance & RAM Optimization (Conservative for 8 GB RAM)
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_MAX_CONTEXT_TOKENS=2048
MAX_IMAGE_DIMENSION=1024

# Persona / Profile Defaults
DEFAULT_AUTHOR_NAME=Aayush Bhatta
DEFAULT_AUTHOR_ROLE=Technical Builder & Engineer
